# Copy this to .env for local dev, and add these in Netlify → Site Settings → Environment Variables

# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here    ← Secret

# Gmail — default sender for every transactional email
GMAIL_USER=ccsgmprojects@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx                 ← Secret

# Resend — optional second sender, selectable from the Follow Up button dropdown.
# Leave unset to keep Gmail as the only option. RESEND_FROM must be on a domain
# verified in your Resend dashboard.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx                 ← Secret
RESEND_FROM=RELAY 2026 <relay@your-verified-domain.com>

# Semaphore SMS — optional. Without the key, SMS is a no-op everywhere.
# Toggle events on/off in Admin → Site Settings. PH mobile numbers only.
SEMAPHORE_API_KEY=your-semaphore-api-key               ← Secret

# Number the follow-up SMS tells registrants to text (Semaphore messages cannot
# be replied to). Falls back to GCASH_MOBILE when unset.
# SMS_REPLY_NUMBER=09475424079

# REQUIRED for SMS to send at all. PH carriers block unregistered sender IDs,
# so there is no usable default — until this is set, every SMS is a logged
# no-op and the dashboard greys the feature out.
# Register the name in your Semaphore account first (max 11 alphanumeric
# characters, approval takes up to 5 business days), then set it here EXACTLY
# as approved — a mismatch is rejected at send time.
# Note: Semaphore is outbound only; recipients cannot reply to these messages.
SEMAPHORE_SENDER_NAME=YOURSENDER

# Admin
ADMIN_EMAIL=ccsgmprojects@gmail.com
ADMIN_PASSWORD=your-secure-password-here               ← Secret

# Site URL
SITE_URL=https://your-site.netlify.app

# BPI Account Details (shown in international form + payment emails)
BPI_ACCOUNT_NAME=Your Account Name Here
BPI_ACCOUNT_NUMBER=1234-5678-90
BPI_ACCOUNT_TYPE=Savings

# GCash Account Details (shown in PH registration form)
GCASH_ACCOUNT_NAME=CCSGM
GCASH_ACCOUNT_HOLDER=MA*K P.
GCASH_MOBILE=+63 947 542 ....
GCASH_USER_ID=..........WFFPZW
JWT_SECRET=your_strong_random_secret_here
IMAGE_SITE_URL=https://your-image-site.netlify.app
